<Window x:Class="_560GUI.Dialogs.AddProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_560GUI.Dialogs"
        mc:Ignorable="d"
        Title="Add Product" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="2" Margin="10">
            <Label>Supplier</Label>
            <ComboBox Name="uxSupplierBox"/>
            <Label>Product Type</Label>
            <ComboBox x:Name="uxProductTypeBox"/>
            <Label>Brand</Label>
            <ComboBox x:Name="uxBrandBox"/>
            <Separator Margin="0,10"/>
            
            <Label>Product Name</Label>
            <TextBox x:Name="uxNameBox"/>
            <Label>Quantity in stock</Label>
            <TextBox x:Name="uxQuantity"/>
            <Label>Bulk Price</Label>
            <TextBox x:Name="uxBulkPrice"/>
            <Label>Sell Price</Label>
            <TextBox x:Name="uxSellPrice"/>
        </StackPanel>
        <Button Grid.Row="1" Margin="5" IsCancel="True" Click="CancelClick">Cancel</Button>
        <Button Grid.Row="1" Grid.Column="1" Margin="5" IsDefault="True" Click="OkayClick">Okay</Button>
    </Grid>
</Window>
