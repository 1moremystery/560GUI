<Window x:Class="_560GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_560GUI"
        mc:Ignorable="d"
        Title="Dream Team Hobby Shop" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="View">
                <MenuItem Header="Customers">
                    <MenuItem Header="All Customers" Click="ViewAllCustomersClick"/>
                    <MenuItem Header="Top 10 Customers" Click="ViewTop10CustomersClick"/>
                </MenuItem>
                <MenuItem Header="Products">
                    <MenuItem Header="All Products" Click="ViewAllProductsClick"/>
                    <MenuItem Header="Product Sales" Click="ViewProductSalesClick"/>
                    <MenuItem Header="Best Selling By Supplier" Click="ViewBestSellingBySupplierClick"/>
                </MenuItem>
                <MenuItem Header="Product Type">
                    <MenuItem Header="Monthly Product Type Sales" Click="ViewMonthlySalesProductTypeClick" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Add">
                <MenuItem Header="Customer" Click="AddCustomerClick"/>
                <MenuItem Header="Product" Click="AddProductClick"/>
            </MenuItem>
        </Menu>
        
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Start:" VerticalAlignment="Center"/>
            <DatePicker x:Name="uxStartDate" SelectedDate="2025-11-01" Margin="5,0,15,0"/>
            <TextBlock Text="Stop / End:" VerticalAlignment="Center"/>
            <DatePicker x:Name="uxStopDate" SelectedDate="2026-11-17" Margin="5,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Report:" VerticalAlignment="Center"/>
            <TextBlock x:Name="uxReportTitle" Text="(none selected)" FontWeight="Bold" FontSize="14"
                       VerticalAlignment="Center" Margin="5,0"/>
        </StackPanel>
            
        <DataGrid DockPanel.Dock="Bottom" x:Name="uxDataGrid"/>
    </DockPanel> 
</Window>
