<Window x:Class="_560GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_560GUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="View">
                <MenuItem Header="Customers" Click="ViewCustomersClick"/>
                <MenuItem Header="Products" Checked="ViewProductsClick"/>
            </MenuItem>

            <MenuItem Header="Add">
                <MenuItem Header="Customer" Click="AddCustomerClick"/>
                <MenuItem Header="Product" Click="AddProductClick"/>
            </MenuItem>
            <MenuItem Header="debug" Click="debugClick"/>
        </Menu>
        <DataGrid DockPanel.Dock="Bottom" x:Name="uxDataGrid">
            
        </DataGrid>
    </DockPanel> 
</Window>
